/* --- LIGHT MODE STYLESHEET --- */

/* --- General Widget Styling --- */
QWidget {
    background-color: #F7FAFC;
    color: #1A202C;
    font-family: 'Segoe UI', 'Roboto', sans-serif;
    font-size: 14px;
}

/* --- Main Window Styling --- */
QMainWindow {
    background-color: #F7FAFC;
}

/* --- Custom Title Bar Styling --- */
QWidget#custom_title_bar {
    background-color: #E2E8F0;
    border-bottom: 1px solid #CBD5E0;
    min-height: 35px;
    max-height: 35px;
}

QLabel#title_label {
    color: #2B6CB0;
    background-color: transparent;
    border: none;
    font-size: 14px;
    font-weight: bold;
    padding-left: 10px;
}

QPushButton#minimize_btn,
QPushButton#maximize_btn,
QPushButton#restore_btn,
QPushButton#close_btn {
    background-color: transparent;
    border: none;
    min-width: 40px;
    max-width: 40px;
    min-height: 35px;
    max-height: 35px;
    padding: 0px;
}

QPushButton#minimize_btn:hover,
QPushButton#maximize_btn:hover,
QPushButton#restore_btn:hover {
    background-color: #CBD5E0;
    border-radius: 17px;
}

QPushButton#theme_toggle_btn:hover {
    background-color: #CBD5E0;
    border-radius: 17px;
}

QPushButton#close_btn:hover {
    background-color: #FC8181;
}

/* Theme Toggle Button */
QPushButton#theme_toggle_btn {
    background-color: transparent;
    border: none;
    min-width: 40px;
    max-width: 40px;
    min-height: 35px;
    max-height: 35px;
    padding: 0px;
    border-radius: 17px;
}

/* --- ScrollBar Styling --- */
QScrollBar:vertical {
    border: none;
    background: #E2E8F0;
    width: 8px;
    margin: 0px 0px 0px 0px;
}
QScrollBar::handle:vertical {
    background: #A0AEC0;
    min-height: 20px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

/* --- Group Box Styling --- */
QGroupBox {
    font-weight: bold;
    border: 2px solid #CBD5E0;
    border-radius: 8px;
    margin-top: 15px;
    padding-top: 10px;
    background-color: #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 5px 0 5px;
    color: #2B6CB0;
    font-size: 16px;
}

/* --- 3D Viewer Controls Panel Styling --- */
QWidget[objectName="controls_container_3d"] {
    background-color: #F7FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
}

QWidget[objectName="controls_container_3d"] QGroupBox {
    font-weight: bold;
    border: 2px solid #CBD5E0;
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 10px;
    background-color: #FFFFFF;
    color: #1A202C;
}

QWidget[objectName="controls_container_3d"] QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: #2B6CB0;
    font-size: 14px;
}

QWidget[objectName="controls_container_3d"] QCheckBox {
    color: #2B6CB0;
    spacing: 5px;
    font-weight: bold;
}

QWidget[objectName="controls_container_3d"] QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #CBD5E0;
    border-radius: 3px;
    background-color: #FFFFFF;
}

QWidget[objectName="controls_container_3d"] QCheckBox::indicator:checked {
    background-color: #4299E1;
    border-color: #4299E1;
}

QWidget[objectName="controls_container_3d"] QCheckBox::indicator:hover {
    border-color: #4299E1;
}

QWidget[objectName="controls_container_3d"] QLabel {
    color: #2B6CB0;
    background-color: transparent;
}

QLabel[objectName="anatomical_systems_title"] {
    font-size: 14px;
    font-weight: bold;
    color: #2B6CB0;
    background-color: transparent;
}

/* Modern Slider Style for 3D Controls */
QWidget[objectName="controls_container_3d"] QSlider::groove:horizontal {
    border: 1px solid #E2E8F0;
    height: 6px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #E2E8F0, stop:1 #CBD5E0);
    border-radius: 3px;
}

QWidget[objectName="controls_container_3d"] QSlider::handle:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #4299E1, stop:1 #2B6CB0);
    border: 2px solid #E2E8F0;
    width: 20px;
    margin: -7px 0;
    border-radius: 10px;
}

QWidget[objectName="controls_container_3d"] QSlider::handle:horizontal:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #63B3ED, stop:1 #4299E1);
    border: 2px solid #4299E1;
}

QWidget[objectName="controls_container_3d"] QSlider::handle:horizontal:pressed {
    background: #2B6CB0;
}

QWidget[objectName="controls_container_3d"] QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #4299E1, stop:1 #63B3ED);
    border-radius: 3px;
}

QWidget[objectName="controls_container_3d"] QSlider::add-page:horizontal {
    background: #E2E8F0;
    border-radius: 3px;
}

QWidget[objectName="controls_container_3d"] QScrollArea {
    border: none;
    background-color: #F7FAFC;
}

QWidget[objectName="controls_container_3d"] QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #4299E1;
    color: #2B6CB0;
    border-radius: 5px;
    padding: 8px;
    font-weight: bold;
    min-height: 35px;
}

QWidget[objectName="controls_container_3d"] QPushButton:hover {
    background-color: #4299E1;
    color: #FFFFFF;
    border: 1px solid #4299E1;
}

QWidget[objectName="controls_container_3d"] QPushButton:pressed {
    background-color: #2B6CB0;
}

/* --- Push Button Styling (General) --- */
QPushButton {
    background-color: #E2E8F0;
    color: #1A202C;
    border: 1px solid #CBD5E0;
    border-radius: 5px;
    padding: 5px;
}

QPushButton:hover {
    background-color: #4299E1;
    color: #FFFFFF;
    border: 1px solid #4299E1;
}

QPushButton:pressed {
    background-color: #2B6CB0;
    border: 1px solid #2B6CB0;
}

QPushButton:checked {
    background-color: #4299E1;
    border: 1px solid #4299E1;
    color: #FFFFFF;
}

/* --- Import Button Styling --- */
QPushButton[objectName="import_btn"] {
    background-color: #FFFFFF;
    border: 1px solid #4299E1;
    color: #2B6CB0;
}

QPushButton[objectName="import_btn"]:hover {
    background-color: #4299E1;
    color: #FFFFFF;
    border: 1px solid #4299E1;
}

/* --- Specific Button Styling --- */
QPushButton[objectName^="open_btn_"],
QPushButton[objectName="load_seg_btn"],
QPushButton[objectName="delete_seg_btn"],
QPushButton[objectName="reset_btn"] {
    background-color: #FFFFFF;
    border: 1px solid #4299E1;
    color: #2B6CB0;
}

QPushButton[objectName^="open_btn_"]:hover,
QPushButton[objectName="load_seg_btn"]:hover,
QPushButton[objectName="delete_seg_btn"]:hover,
QPushButton[objectName="reset_btn"]:hover {
    background-color: #4299E1;
    color: #FFFFFF;
    border: 1px solid #4299E1;
}

QPushButton[objectName^="export_btn_"] {
    background-color: #FFFFFF;
    border: 1px solid #FC8181;
    color: #E53E3E;
}

QPushButton[objectName^="export_btn_"]:hover {
    background-color: #FC8181;
    color: #FFFFFF;
    border: 1px solid #FC8181;
}

QPushButton[objectName^="export_btn_"]:checked {
    background-color: #FC8181;
    color: #FFFFFF;
    border: 1px solid #FC8181;
}

/* --- Frame and Panel Styling --- */
QFrame {
    background-color: #FFFFFF;
    border: none;
    border-radius: 5px;
}

QFrame#sidebar {
    background-color: #F7FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
}

QFrame[objectName^="viewing_panel_"] {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E0;
    border-radius: 8px;
}

QLabel[objectName^="view_"] {
    background-color: black;
    border: none;
    color: #CBD5E0;
    font-size: 18px;
}

QLabel[objectName^="view_title_"] {
    color: #1A202C;
    font-size: 16px;
    font-weight: bold;
    background-color: transparent;
    border: none;
}

/* --- Dialog Styling --- */
QDialog {
    background-color: #F7FAFC;
}

QWidget#dialog_title_bar {
    background-color: #E2E8F0;
    border-bottom: 1px solid #CBD5E0;
    min-height: 35px;
    max-height: 35px;
}

QLabel#dialog_title_label {
    color: #2B6CB0;
    background-color: transparent;
    border: none;
    font-size: 14px;
    font-weight: bold;
    padding-left: 10px;
}

QPushButton#dialog_close_btn {
    background-color: transparent;
    border: none;
    min-width: 40px;
    max-width: 40px;
    min-height: 35px;
    max-height: 35px;
    padding: 0px;
}

QPushButton#dialog_close_btn:hover {
    background-color: #FC8181;
}

QWidget#dialog_content {
    background-color: #F7FAFC;
}

QLabel#dialog_info_label {
    color: #1A202C;
    padding-bottom: 10px;
}

QDialog QSpinBox {
    background-color: #FFFFFF;
    color: #1A202C;
    border: 1px solid #CBD5E0;
    border-radius: 5px;
    padding: 5px;
    min-height: 25px;
}

QDialog QSpinBox::up-button,
QDialog QSpinBox::down-button {
    background-color: #E2E8F0;
    border: 1px solid #CBD5E0;
    width: 16px;
}

QDialog QSpinBox::up-button:hover,
QDialog QSpinBox::down-button:hover {
    background-color: #4299E1;
}

QDialog QSpinBox::up-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 6px solid #1A202C;
    width: 0;
    height: 0;
}

QDialog QSpinBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid #1A202C;
    width: 0;
    height: 0;
}

QDialog QDialogButtonBox QPushButton {
    background-color: #E2E8F0;
    color: #1A202C;
    border: 1px solid #CBD5E0;
    border-radius: 5px;
    padding: 8px 16px;
    min-width: 80px;
    min-height: 30px;
}

QDialog QDialogButtonBox QPushButton:hover {
    background-color: #4299E1;
    color: #FFFFFF;
    border: 1px solid #4299E1;
}

QDialog QDialogButtonBox QPushButton:pressed {
    background-color: #2B6CB0;
}

QDialog QLabel {
    color: #1A202C;
    background-color: transparent;
}

/* --- Segmentation View Dropdown Styling --- */
QComboBox#segmentation_view_dropdown {
    background-color: #FFFFFF;
    color: #1A202C;
    border: 1px solid #CBD5E0;
    border-radius: 5px;
    padding: 5px;
    min-height: 25px;
}

QComboBox#segmentation_view_dropdown::drop-down {
    border: none;
    width: 20px;
}

QComboBox#segmentation_view_dropdown::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid #1A202C;
    width: 0;
    height: 0;
}

QComboBox#segmentation_view_dropdown:hover {
    background-color: #E2E8F0;
    border: 1px solid #4299E1;
}

QComboBox#segmentation_view_dropdown QAbstractItemView {
    background-color: #FFFFFF;
    color: #1A202C;
    selection-background-color: #4299E1;
    selection-color: #FFFFFF;
    border: 1px solid #CBD5E0;
}

/* Tab bar styling */
#tab_bar {
    background-color: #EDF2F7;
    border-bottom: 1px solid #CBD5E0;
}

#mpr_tab, #td_tab {
    background-color: transparent;
    color: #4A5568;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: 13px;
    font-weight: 500;
    padding: 5px 15px;
}

#mpr_tab:checked, #td_tab:checked {
    color: #2B6CB0;
    border-bottom: 2px solid #4299E1;
    background-color: #CBD5E0;
}

#mpr_tab:hover, #td_tab:hover {
    background-color: #CBD5E0;
}

#title_bar_container {
    background-color: #EDF2F7;
}